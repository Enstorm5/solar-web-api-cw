{
  "name": "slsea-solar-api",
  "version": "0.1.0",
  "private": true,
  "description": "SLSEA real-time and historical solar generation REST API (NB6007CEM coursework)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "build": "tsx scripts/build-docs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "express": "5.2.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "swagger-ui-dist": "5.33.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
