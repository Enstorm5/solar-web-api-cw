{
  "name": "slsea-solar-api",
  "version": "0.1.0",
  "private": true,
  "description": "SLSEA real-time and historical solar generation REST API (NB6007CEM coursework)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env scripts/dev.ts",
    "build": "tsx scripts/build-docs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:verify": "tsx --env-file-if-exists=.env scripts/verify-seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "token": "tsx --env-file-if-exists=.env scripts/issue-token.ts",
    "db:runtime-role": "tsx --env-file-if-exists=.env scripts/create-runtime-role.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "simulate": "tsx --env-file-if-exists=.env scripts/simulate-device.ts"
  },
  "dependencies": {
    "@vercel/functions": "3.9.11",
    "express": "5.2.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "swagger-ui-dist": "5.33.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
