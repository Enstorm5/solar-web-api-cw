# Copy to .env (git-ignored). Never commit real values.
# Pooled Neon runtime connection (sslmode=require)
DATABASE_URL=
# Direct (non-pooled) Neon connection used only by migrate/seed CLIs
MIGRATION_DATABASE_URL=
# JWT verification (public key only on the API; PEM with \n escapes or base64)
JWT_PUBLIC_KEY=
JWT_ISSUER=https://auth.slsea.example/solar
JWT_AUDIENCE=solar-api
NODE_ENV=development
LOG_LEVEL=info
# Seed job only
SEED_ANCHOR_UTC=
SEED_RANDOM_SEED=20261007
